#======= General variables ======
SpinPolarized    .false.
PAO.BasisSize     DZP
PAO.SplitTailNorm true
PAO.SplitNormH          0.30

MeshCutoff            250.0 Ry
XC.functional         GGA 
XC.authors            PBE
ElectronicTemperature   25 meV
UseSaveData           .true.
PAO.EnergyShift       0.02 Ry

#============== MD variables =======
MD.TypeOfRun          CG
MD.NumCGsteps         40
MD.MaxForceTol        0.01 eV/Ang
MD.MaxStressTol       0.01 GPa
MD.UseSaveXV          .true.
MD.FinalTimeStep      1
MD.VariableCell F
MD.ConstantVolume T
#=================================
%block GeometryConstraints
position from 1 to   18
position from -1 to -18
%endblock GeometryConstraints
#======== SCF variables ==========
MaxSCFIterations      500
DM.MixingWeight       0.01
DM.NumberPulay        3
DM.UseSaveDM          .true.
DM.Tolerance           1.d-4

#======== Write ============

SolutionMethod        diagon
ParallelOverK         .true.

WriteMullikenPop                 1
WriteKbands                     .true.
WriteBands                      .true.
SaveRho                         .true.
SaveDeltaRho                    .true.
SaveHS                          .false.
SaveElectrostaticPotential      F
SaveTotalPotential              no
WriteCoorXmol                   .true.
WriteMDXmol                     .true.
WriteMDhistory                  .false.
WriteEigenvalues                 yes

# Exchange-correlation and vdW
XC.functional     GGA
XC.authors        PBE
VDWcorrection     .true.
VDWscheme         DRSLL
