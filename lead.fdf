##======= General variables ======
PAO.BasisSize     DZP
PAO.SplitTailNorm true
PAO.SplitNormH          0.30

MeshCutoff            250.0 Ry
XC.functional         GGA 
XC.authors            PBE
ElectronicTemperature    25 meV
UseSaveData           .true.
PAO.EnergyShift       0.15 eV

#============== MD variables =======
MD.TypeOfRun          CG
MD.NumCGsteps         0
MD.MaxForceTol        0.01 eV/Ang
MD.MaxStressTol       0.05 GPa
MD.UseSaveXV          .true.
MD.FinalTimeStep      1

#=================================
#======== SCF variables ==========
MaxSCFIterations      1000
DM.MixingWeight       0.08
DM.NumberPulay        3
DM.UseSaveDM          .true.
DM.Tolerance           1.d-4

#======== Write ============

SolutionMethod        diagon
ParallelOverK         .true.

SpinPolarized                   .true.
WriteMullikenPop                1
WriteBands                      .false.
SaveRho                         .false.
SaveDeltaRho                    .false.
SaveHS                          .false.
SaveElectrostaticPotential      F
SaveTotalPotential              no
WriteCoorXmol                   .true.
WriteMDXmol                     .true.
WriteMDhistory                  .false.
WriteEigenvalues                yes
